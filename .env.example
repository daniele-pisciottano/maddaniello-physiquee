# Supabase — client-side (sicure da esporre al browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (per Netlify Functions, NON VITE_*)
# Usate in fasi successive per:
#  - SUPABASE_SERVICE_ROLE_KEY: operazioni privilegiate lato server
#  - MASTER_ENCRYPTION_KEY: cifratura a riposo delle API key AI (AES-256-GCM)
SUPABASE_SERVICE_ROLE_KEY=
MASTER_ENCRYPTION_KEY=
