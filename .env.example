# ============================================================
# Client-side (esposte al browser, sicure: sono anon)
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Server-side (SOLO Netlify Functions, mai esposte al browser)
# In locale servono solo se usi `netlify dev`. In deploy mettile
# su Netlify → Site configuration → Environment variables.
# ============================================================

# Alias server-side delle Supabase env (stessi valori delle VITE_*).
# Le Functions leggono prima SUPABASE_URL, poi fallback su VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key — dà accesso admin al DB, bypassa RLS.
# Supabase → Settings → API → service_role (attenzione: segreto!)
SUPABASE_SERVICE_ROLE_KEY=

# Master key per cifrare le API key AI a riposo nel DB (AES-256-GCM).
# DEVE essere esattamente 64 caratteri hex = 32 byte.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENZIONE: se la perdi, le API key salvate non sono più recuperabili.
MASTER_ENCRYPTION_KEY=
